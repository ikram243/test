# Copy this file to .env and fill in your own values. Never commit .env.

# Google Gemini API key — used ONLY to phrase the Bangla sentence more naturally.
# Leave empty to use the built-in Bangla templates (everything still works offline).
GEMINI_API_KEY=
ROADMIND_GEMINI_MODEL=gemini-3.8-flash

# YOLO weights. yolo11n.pt downloads automatically. Put fine-tuned weights at models/roadmind.pt
# 2-3x faster on a laptop CPU: run  python scripts/speed_up.py  and use the line it prints, e.g.
# ROADMIND_MODEL=models/yolo11n_openvino_model
ROADMIND_MODEL=models/yolo11n.pt

# Detection size: 640 = fast. 960 = finds small, far-away vehicles better (about 2x slower).
ROADMIND_IMG_SIZE=640
# Minimum confidence to keep a detection (0.30 default). Lower = finds more but more mistakes.
ROADMIND_CONFIDENCE=0.30

# Which junction opens first (file name in junctions/ without .json)
ROADMIND_DEFAULT_JUNCTION=demo

# AI looks at every Nth new frame (1 = as fast as the CPU allows). The video itself stays smooth either way.
# Use 2 or 3 on free hosting to save CPU.
ROADMIND_DETECT_EVERY=1

# Seconds between automatic advice. 0 = once per signal cycle (the junction's cycle_seconds).
# For a live demo, 30 shows new advice more often.
ROADMIND_ADVICE_INTERVAL=0
